PORT=2000
# Bind address. Use 0.0.0.0 so the server is reachable from other devices
# on the same Wi-Fi / LAN. Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sparktrust?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password
# FRONTEND_URL=http://localhost:5173
NODE_ENV=production