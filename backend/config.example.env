PORT=2000
# Bind address. Use 0.0.0.0 so the server is reachable from other devices
# on the same Wi-Fi / LAN. Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
DB_HOST=localhost
DB_USER=your_dbusername
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
# Initial administrator is inserted only when ADMIN_PASSWORD is configured.
# Use a unique password with at least 12 characters in the backend host settings.
ADMIN_EMAIL=admin@sms.af
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=SMS Admin

# Optional SMTP settings enable email-based password recovery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
FRONTEND_URL=https://construction-website-xi-ten.vercel.app
PUBLIC_API_URL=https://your-backend-host.example
NODE_ENV=production
