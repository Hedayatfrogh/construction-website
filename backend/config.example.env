PORT=2001
# Bind address. Use 0.0.0.0 so the server is reachable from other devices
# on the same Wi-Fi / LAN. Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Never commit the real value.
MONGODB_URI=
# Optional: database name if it is not part of MONGODB_URI.
MONGODB_DB_NAME=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Initial administrator, created on first start if it does not exist (password: 12+ characters).
# Run `npm run seed:admin` to reset this admin's password to ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Extra allowed frontend origins (comma-separated), in addition to the built-in list.
CORS_ORIGINS=

# SMTP (Gmail: smtp.gmail.com, port 587, App Password — never the account password).
# CONTACT_EMAIL is the administrator inbox that receives Contact form submissions.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=
EMAIL_FROM=
# Aliases still accepted: EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS.
FRONTEND_URL=https://construction-website-xi-ten.vercel.app
# Public base URL of this backend, used to build uploaded image URLs.
PUBLIC_API_URL=https://your-backend-host.example
