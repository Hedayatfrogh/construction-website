PORT=2000
# Bind address. Use 0.0.0.0 so the server is reachable from other devices
# on the same Wi-Fi / LAN. Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
# Local SQLite database file (relative to the backend folder). Created automatically.
DB_PATH=data/database.sqlite
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password
# FRONTEND_URL=http://localhost:5173
NODE_ENV=production

# The local admin login lives in config/adminCredentials.js.
# Optional overrides for `npm run seed`:
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ── Manual admin fallback ─────────────────────────────────────────────────
# When MySQL is unavailable, /api/v1/users/login will fall back to these
# credentials instead of 500'ing. Generate a bcryptjs hash with:
#   node scripts/generate-admin-hash.js "<your-password>"
ADMIN_USERNAME=admin@sms.af
ADMIN_PASSWORD_HASH=
ADMIN_NAME=SMS Admin
ADMIN_ROLE=admin