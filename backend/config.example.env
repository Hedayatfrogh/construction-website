PORT=2000
# Bind address. Use 0.0.0.0 so the server is reachable from other devices
# on the same Wi-Fi / LAN. Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
# Local SQLite database file (relative to the backend folder). Created automatically.
DB_PATH=data/database.sqlite
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password
# FRONTEND_URL=http://localhost:5173
NODE_ENV=production

# Configure the initial administrator before running `npm run seed`.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# Optional SMTP settings enable email-based password recovery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
FRONTEND_URL=https://construction-website-xi-ten.vercel.app
PUBLIC_API_URL=https://your-backend-host.example
